# ==============================================================================
# Multi-Agent AI System - Environment Configuration Template
# Copy this file to '.env' and provide your credentials before starting the system.
# ==============================================================================

# --- LLM API Credentials ---
# OpenAI API Key (required for live reasoning; fallback simulated runner activates if unset)
OPENAI_API_KEY=your_openai_api_key_here

# Default Model Selection (e.g., gpt-4o-mini, gpt-4o, gpt-4-turbo)
OPENAI_MODEL=gpt-4o-mini

# --- Storage & Database Paths ---
# SQLite persistent relational database path for memory, sessions, and reports
SQLITE_DB_PATH=data/research_memory.db

# ChromaDB vector store directory for RAG document chunk embeddings
CHROMA_PERSIST_DIRECTORY=data/chroma

# --- Backend API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend Streamlit Configuration ---
STREAMLIT_PORT=8501
BACKEND_API_URL=http://localhost:8000

# --- Multi-Agent Orchestration Tuning ---
# Minimum composite verification integrity threshold required to pass quality gate (0.0 - 1.0)
VERIFICATION_THRESHOLD=0.70

# Maximum permitted revision loops upon quality gate failure
MAX_REVISION_ITERATIONS=2
